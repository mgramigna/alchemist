# Copy to .env for local development. Alchemy loads .env automatically;
# shell environment variables take precedence.
APP_ORIGIN=http://localhost:5173

# Placeholders let the app start. Replace both with a Google Web application
# client's credentials to sign in (see docs/authentication.md).
GOOGLE_CLIENT_ID=local-placeholder-client-id
GOOGLE_CLIENT_SECRET=local-placeholder-client-secret
