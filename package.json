{
  "name": "alchemist",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.6",
      "@effect/tsgo": "0.57.0",
      "@effect/vitest": "4.0.6",
      "@types/node": "24.19.2",
      "effect": "4.0.6",
      "typescript": "7.0.2",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@tanstack/intent": "0.5.6",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{json,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3",
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/react-form",
      "@tanstack/form-core",
      "@tanstack/react-table",
      "@tanstack/table-core"
    ]
  }
}
