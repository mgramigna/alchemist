{
  "name": "alchemist",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.6",
      "@effect/tsgo": "0.57.0",
      "@effect/vitest": "4.0.6",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-router-devtools": "1.167.2",
      "@tanstack/router-plugin": "1.168.48",
      "@types/node": "24.19.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "effect": "4.0.6",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "vitest": "5.0.5",
      "@effect/sql-d1": "4.0.6",
      "@effect/atom-react": "4.0.6",
      "@cloudflare/workers-types": "5.20261025.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter @alchemist/web build",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter @alchemist/web dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc -b",
    "deploy": "bun run build && node node_modules/alchemy/bin/cli.js deploy",
    "smoke": "node tools/smoke-public-script.ts",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "dev:worker": "bun run build && node node_modules/alchemy/bin/cli.js dev"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@tanstack/intent": "0.5.6",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@alchemist/domain": "workspace:*",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "catalog:",
    "@playwright/test": "1.64.1",
    "alchemy": "2.0.0-beta.84"
  },
  "lint-staged": {
    "*.{json,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.4.3",
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/react-form",
      "@tanstack/form-core",
      "@tanstack/react-table",
      "@tanstack/table-core"
    ]
  }
}
